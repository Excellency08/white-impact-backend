# Server
NODE_ENV=development
PORT=3030

# Database
DATABASE_URL=
DIRECT_URL=
DB_SSL=false
DB_SSL_CA=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=whiteimpact
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Optional Supabase services (server-side only; never expose service role keys in the frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_ENABLED=false

# Frontend / CORS
FRONTEND_URL=http://localhost:5500
CORS_ORIGIN=http://localhost:5500
ALLOWED_ORIGINS=http://localhost:5500

# Email
STAFF_EMAIL=
FROM_EMAIL=
RESEND_API_KEY=
SEND_EMAILS=false
MOCK_EMAIL=true
SITE_URL=http://localhost:5500

# Auth
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
AUTH_SESSION_TTL_DAYS=30
AUTH_VERIFY_TTL_HOURS=24
AUTH_RESET_TTL_HOURS=2
BOOTSTRAP_ADMIN_NAME=Bootstrap Admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_ROLE=super_admin
