# Runtime
NODE_ENV=production
PORT=3030

# Supabase PostgreSQL
DATABASE_URL=
DIRECT_URL=
DB_SSL=true
DB_CONNECTION_TIMEOUT=10000
DB_CONNECTION_RETRIES=3
DB_CONNECTION_RETRY_DELAY=1500

# Browser/API access
FRONTEND_URL=https://your-frontend-domain.example
ALLOWED_ORIGINS=https://your-frontend-domain.example

# Existing application authentication
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_TTL=15m
AUTH_SESSION_TTL_DAYS=30
AUTH_VERIFY_TTL_HOURS=24
AUTH_RESET_TTL_HOURS=2

# First administrator bootstrap
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# Email
SEND_EMAILS=false
MOCK_EMAIL=true
RESEND_API_KEY=
STAFF_EMAIL=
FROM_EMAIL=

# Donations
DONATION_BANK_NAME=
DONATION_ACCOUNT_NUMBER=
DONATION_ACCOUNT_NAME=
SITE_URL=https://your-frontend-domain.example
BACKEND_URL=https://your-api-domain.example

# Uploads and operational limits
MAX_FILE_SIZE=5242880
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
